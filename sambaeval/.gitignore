# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
/dist

# misc
.DS_Store
*.pem

# Local scratch / work-in-progress notes, never committed
/private/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# typescript
*.tsbuildinfo

# python venv (created lazily by scripts/setup-venv.mjs)
/.venv/

# python bytecode cache (autogenerated when scripts/generators/* are imported)
__pycache__/
*.pyc

# local scratch / private working files (notes, scratch diffs, etc.) — never committed.
/private/

# sambaeval local data
# providers.json holds API keys and must never be committed.
/data/providers.json

# SciCode numeric reference data (~1 GB). Downloaded separately and pointed to
# via test_data_h5_path in scripts/generators/scicode_generator.py — never
# committed. See the SciCode section of the README.
*.h5

# SciCode raw upstream source, needed only to regenerate the fixture via
# convert_scicode.py. The committed, self-contained fixture
# (data/datasets/scicode/scicode_problems.jsonl) is the canonical artifact, so
# these inputs are not committed. The `problems_*.jsonl` glob covers the HF
# source files (problems_dev/test.jsonl) and the legacy problems_all.jsonl
# without matching the committed scicode_problems.jsonl. See the README in
# data/datasets/scicode/ for download links.
/data/datasets/scicode/problems_*.jsonl
/data/datasets/scicode/*.txt

# Spider 1.0 raw upstream dataset (~1.7 GB incl. the SQLite database/ and
# test_database/ dirs). Downloaded separately from the official Spider release
# and never committed — mirrors the SciCode treatment above. Needed only to
# regenerate the fixture via convert_spider.py and to execute queries at run
# time. The committed, self-contained fixtures
# (data/datasets/spider1/spider_examples.jsonl and data/datasets/spider_dev.jsonl)
# are the canonical artifacts; see the README in data/datasets/spider1/ for the
# download link.
/data/datasets/spider1/spider_data/
/data/datasets/spider1/spider/
/data/datasets/spider1/database/
/data/datasets/spider1/*.sqlite
/data/datasets/spider1/dev.json
/data/datasets/spider1/train_spider.json
/data/datasets/spider1/tables.json
